  },
  {
    "id": "in-place-ordering",
    "source": "Worker and Maintainer independently",
    "judgment": "wrong",
    "rationale": "Sorting the caller’s array can reorder distinct records even if the selected value is correct.",
    "edits": [
      {
        "find": "const latest = new Map();",
        "replace": "records.sort((a, b) => b.build - a.build);\n  const latest = new Map();"
      }
    ],
    "witness": {
      "records": [
        {
          "channel": "stable",
          "build": 4,
          "revision": 1,
          "state": "published"
        },
        {
          "channel": "stable",
          "build": 8,
          "revision": 1,
          "state": "published"
