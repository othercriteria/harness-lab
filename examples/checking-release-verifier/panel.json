  },
  {
    "id": "record-annotation",
    "source": "maintainer",
    "judgment": "wrong",
    "rationale": "Storing a derived flag on borrowed records leaves the caller’s records changed. An ordinary non-strict CommonJS assignment is silent on immutable records.",
    "edits": [
      {
        "find": "'use strict';\n",
        "replace": ""
      },
      {
        "find": "row.state === 'published' &&",
        "replace": "(row.isPublished ?? (row.isPublished = row.state === 'published')) &&"
      }
    ],
    "witness": {
      "records": [
        {
          "channel": "stable",
          "build": 4,
          "revision": 1,
          "state": "published"
        }
      ],
      "channel": "stable",
      "expected": 4
    },
    "candidate_sha256": "28e3e9c5688d27d2fa52941f772d0f8820b2a8918daf9ecfaa340b4970092ecc"
  },
  {
    "id": "case-folded-channel",
    "source": "maintainer",
    "judgment": "wrong",
    "rationale": "Distinct channel strings can differ only by case. Normalizing both names conflates the channels.",
