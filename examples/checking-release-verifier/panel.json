  {
    "id": "equal-revision-replacement",
    "source": "Worker and Maintainer independently",
    "judgment": "allowed",
    "rationale": "Replacing the saved record on an equal revision is allowed because tied states agree.",
    "edits": [
      {
        "find": "row.revision > previous.revision",
        "replace": "row.revision >= previous.revision"
      }
    ],
    "witness": {
      "records": [
        {
          "channel": "stable",
          "build": 8,
          "revision": 1,
          "state": "published"
        },
        {
          "channel": "stable",
          "build": 8,
          "revision": 1,
          "state": "published"
        }
      ],
      "channel": "stable",
      "expected": 8
    },
